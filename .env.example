# MailGuard AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Optional: Alternative geolocation API key (ip-api.com is free, no key needed)
# IPAPI_KEY=

# Optional: Maximum body size in characters (default: 100000)
# MAX_BODY_SIZE=100000

# Optional: Database path (default: data/mailguard.db)
# DB_PATH=data/mailguard.db

# Optional: Enable debug mode (default: false)
# DEBUG=false
